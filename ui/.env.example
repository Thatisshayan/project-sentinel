# Base URL of the Sentinel backend (no trailing slash).
# Required — without it, the UI fails fast with an ApiConfigError on first fetch.
# api() enforces an 8-second timeout (AbortController); pages render an empty
# state on timeout or network error instead of hanging.
SENTINEL_API_URL=http://localhost:3000

# Must match the backend's SENTINEL_UI_KEY exactly — required in production,
# protects the backend's /api routes. Generate with: openssl rand -hex 32
SENTINEL_UI_KEY=
