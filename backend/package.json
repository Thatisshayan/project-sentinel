{
  "name": "sentinel-backend",
  "version": "1.0.0",
  "description": "Project Sentinel — Phase 1 core loop",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node --esm src/migrate.ts",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "test:integration": "echo 'Integration tests require Docker — run test-integration.yml workflow or install Docker locally'",
    "lint": "eslint src/ --max-warnings 1000",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@notionhq/client": "3.1.3",
    "@sentry/node": "^8.55.2",
    "axios": "^1.19.0",
    "bullmq": "^5.81.3",
    "dotenv": "16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "7.5.1",
    "ioredis": "^5.3.2",
    "pg": "^8.22.0",
    "pino": "8.21.0",
    "simple-git": "^3.22.0",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "prettier": "^3.9.6",
    "supertest": "6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
