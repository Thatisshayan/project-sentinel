{
  "name": "sentinel-backend",
  "version": "1.0.0",
  "description": "Project Sentinel — Phase 1 core loop",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "lint": "eslint src/ --max-warnings 1000",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@notionhq/client": "3.0.0",
    "@sentry/node": "^8.55.2",
    "axios": "^1.6.7",
    "bullmq": "^5.4.2",
    "dotenv": "16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "7.1.5",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "8.17.2",
    "simple-git": "^3.22.0",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "29.7.0",
    "nodemon": "3.0.3",
    "prettier": "^3.9.5",
    "supertest": "6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
