# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
NOTION_API_KEY=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEBUGGER_SHARED_SECRET=
# Your GitHub organization or username (e.g. myorg or myusername)
GITHUB_ORG=
# Comma-separated list of repo short names to watch (e.g. myapp,api,docs)
WATCHED_REPOS=

# ── Telegram topic IDs (one per repo, leave 0 to post in general chat) ────────
TOPIC_PROJECT_SENTINEL=0
TOPIC_ACC=0
TOPIC_ALPHONSOECOSYSTEM=0
TOPIC_SHIPOREX=0
TOPIC_PROJECT_AEGIS=0
TOPIC_TAPCASH=0
TOPIC_SESSIONGUARD=0
TOPIC_COSTPILOT=0
TOPIC_MINT=0
TOPIC_OBSIDIANSTUDIO=0
TOPIC_OBSIDIANMEDIA=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Required in production — protects the UI API. Generate with: openssl rand -hex 32
SENTINEL_UI_KEY=

# ── Phase 2 placeholders — leave empty until Phase 2 build starts ─────────────
VERCEL_TOKEN=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
DEBUGGER_DRY_RUN=true
DATABASE_URL=
# Your Database CA certificate (required for Railway Postgres with TLS)
DATABASE_CA_CERT=
REDIS_URL=
OPENCODE_API_KEY=
NVIDIA_API_KEY=
# Aider (build-repair agent) model — defaults to NVIDIA NIM Llama 3.1 70B via the
# openai/ prefix (see aiderRunner.js). Requires NVIDIA_API_KEY. Codestral and
# Qwen-coder are NOT available/entitled on all NIM accounts — verify with
# `curl https://integrate.api.nvidia.com/v1/chat/completions` before switching.
AIDER_MODEL=openai/meta/llama-3.1-70b-instruct
# DashScope base URL — change to intl endpoint if your Alibaba account is international:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Max minutes aider runs per task before it is killed (default: 20)
AIDER_TIMEOUT_MINUTES=20
# Telegram topic ID for the agent room (standup + leaderboard posts go here)
AGENT_ROOM_TOPIC_ID=
# Comma-separated repo names to track business metrics for the priority engine (default: tapcash)
BUSINESS_METRIC_REPOS=tapcash
# IANA timezone for all scheduled cron jobs (default: America/Toronto)
SENTINEL_TIMEZONE=America/Toronto

# ── AI provider keys (LLM agent pool) ──────────────────────────────────────────
# Each key activates the corresponding agent(s) in agentRegistry.ts / builderRouter.ts.
# NVIDIA_API_KEY is above (Required-ish for the default agent pool).
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# Only needed if you re-enable the 'claude' agent in agentRegistry.ts.
ANTHROPIC_API_KEY=
# Real OpenAI key/base — only used as a fallback when NOT routing through NVIDIA's
# OpenAI-compatible endpoint (see aiderRunner.ts).
OPENAI_API_KEY=
# Kill switch for ai/client.ts's callAnyProvider() (D-005) — set to false/0 to
# hard-disable all billable AI provider calls even when keys above are set
# (e.g. a staging env sharing prod keys). Defaults to enabled.
AI_PROVIDER_CALLS_ENABLED=true

# ── Telegram agent bots (one bot per AI agent persona, for the agent room) ─────
# Optional — agents without a token just don't get their own bot identity.
# See commands/agents.ts for the missing-token warning this drives.
BOT_TOKEN_NEMOTRON=
BOT_TOKEN_QWEN_CODER=
BOT_TOKEN_QWEN_DASH=
BOT_TOKEN_GEMINI=
BOT_TOKEN_QWEN_MAX=
BOT_TOKEN_QWEN_TURBO=
BOT_TOKEN_LLAMA=
BOT_TOKEN_DEEPSEEK=

# ── Observability ───────────────────────────────────────────────────────────────
# Sentry error monitoring. Leave empty to disable (logs a warning at boot instead).
SENTRY_DSN=

# ── Slack (2026-07-22 — see docs/2026-07-22-slack-agent-roster-plan.md) ────────
# Slack app bot token + signing secret — created via docs/slack-app-manifest.json.
# Outbound messages fan out automatically once slack_channels has a mapping for a
# repo (created on onboarding, or backfilled via scripts/backfillSlackChannels.js).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Real Slack user ID of the "Viktor" external agent — required before Phase 6's
# authority/delegate features (viktorAuthority.ts, viktorWatcher.ts) do anything
# at all; unset means completely inert (fail-closed by design). Needs the Slack
# app's users:read scope + reinstall to resolve — see scripts/inspectSlackUsers.js.
VIKTOR_SLACK_USER_ID=
# Slack bot's own user ID (starts with B...). Used to filter echo-loop messages
# so Sentinel doesn't treat its own synthesis posts as external agent replies.
# Required when SLACK_BOT_TOKEN is set; get via `curl -H "Authorization: Bearer $SLACK_BOT_TOKEN" https://slack.com/api/auth.test`
SLACK_BOT_ID=
# Minutes before an unanswered Phase 7 roundtable forces a synthesis anyway
# (default: 5). See agents/roundtable.ts.
ROUNDTABLE_TIMEOUT_MIN=5
# Minutes to wait after a human commit before running Sentinel's own fallback
# audit if CodeRabbit's PR-comment ingestion never showed up (default: 45).
# See scheduledJobsWorker.ts's coderabbit-fallback-audit job.
CODERABBIT_FALLBACK_DELAY_MIN=45
# For the original /webhook/coderabbit receiver — confirmed DORMANT for this
# repo's GitHub-based CodeRabbit setup (CodeRabbit has no outbound webhook for
# GitHub repos; findings arrive as GitHub PR review comments instead, ingested
# via the existing /webhook/github route). Leave unset unless you've confirmed
# your CodeRabbit account actually needs this endpoint.
CODERABBIT_WEBHOOK_SECRET=

# ── Deploy / integration ────────────────────────────────────────────────────────
# GitHub PAT — used to clone repos for aider/build tasks and query build status.
GITHUB_TOKEN=
# This host's public domain (e.g. sentinel.yourdomain.com) — used to print the
# webhook URL during repo onboarding and to register GitHub webhooks automatically.
PUBLIC_DOMAIN=
# NIST NVD API key — raises the CVE-lookup rate limit in dependencyScanner.ts.
# Optional; scans work without it, just slower.
NIST_NVD_API_KEY=

# ── Notion overrides ─────────────────────────────────────────────────────────────
# Only needed if using a separate Notion page/database from the main NOTION_DATABASE_ID.
NOTION_DASHBOARD_PAGE_ID=
NOTION_TASKS_DATABASE_ID=

# ── Business metrics (TapCash / revenue-tracking repos) ────────────────────────
# Either Firebase (direct SDK) or a metrics HTTP endpoint — see businessMetrics.ts.
FIREBASE_PROJECT_ID=
TAPCASH_METRICS_URL=
TAPCASH_METRICS_KEY=
# JSON array of {source, url, key} objects — alternative to the two vars above
# when tracking more than one external metrics source. See metricsFetcher.ts.
METRICS_SOURCES=

# ── CostPilot integration (optional cost-tracking service) ─────────────────────
COSTPILOT_API_URL=
COSTPILOT_API_KEY=

# ── Agent / audit orchestration tuning (all have sane defaults — override only
#    if you know what you're changing) ────────────────────────────────────────
# Master on/off switches — set to 'false' to disable that agent class entirely.
AUDIT_AGENT_ENABLED=true
BUILDER_AGENT_ENABLED=true
# Skip re-auditing a repo if it already has this many tasks queued (default: 3).
MIN_QUEUED_BEFORE_SKIP_AUDIT=3
# Hours before an un-actioned audit auto-expires (default: 24).
AUDIT_APPROVAL_TIMEOUT_H=24
# Minimum hours between audits of the same repo (default: 12).
AUDIT_COOLDOWN_HOURS=12
# Tasks per batch when writing audit tasks to Notion (default: 5).
TASK_BATCH_SIZE=5
# Builder tasks allowed per day across the whole portfolio (default: 10) —
# selfScaler.ts may override this dynamically; this is the static default/floor.
MAX_BUILDER_TASKS_PER_DAY=10
# Concurrent repos the parallel executor will run at once (default: 3).
MAX_PARALLEL_AGENTS=3
# Consecutive debug/fix attempts before giving up on a build failure (default: 5).
MAX_DEBUG_ATTEMPTS=5
# Minutes before an aider/claude debug run is killed (default: 30, falls back to
# AIDER_TIMEOUT_MINUTES if unset).
DEBUG_TIMEOUT_MINUTES=30
# Hard ceiling on any builder-fallback loop (taskBuilder.ts, aiderRunner.ts) before
# LoopGuard stops and escalates to a human via Telegram instead of retrying
# indefinitely (default: 25). See utils/loopGuard.ts.
LOOP_GUARD_MAX_ITERATIONS=25
# Model overrides per agent role — all default to a sensible NIM/DashScope model
# if left unset. See auditOrchestrator.ts, claudeCodeAudit.ts, sprintPlanner.ts,
# owaspChecker.ts, agentRoom.ts, sentinelBrain.ts, claudeCodeRunner.ts,
# builderRouter.ts respectively.
AUDIT_MODEL=
BUILD_MODEL=
SPRINT_MODEL=
OWASP_MODEL=
CHAT_MODEL=
NVIDIA_MODEL=
# Same shape as CROSS_REPO_DEPS below but historically named PRIMARY/FALLBACK —
# used by settingsLoader.ts as the initial default settings row, overridable via
# /sentinel settings in Telegram afterward.
PRIMARY_AGENT=nvidia
FALLBACK_AGENT=gemini
BUILD_AGENT=nvidia
MAX_ACTIVE_AGENTS=4
AUTO_APPROVE_TASKS=false
DAILY_REPORT_TIME=07:00:00
EMAIL_DIGEST=false
TELEGRAM_ALERTS=true

# ── Sprint / capacity planning ──────────────────────────────────────────────────
# Max tasks per weekly sprint proposal (default: 15).
SPRINT_MAX_TASKS=15
# Monthly AI-spend budget in USD used by capacityManager.ts to throttle task
# generation as spend approaches the limit (default: 30).
SPRINT_MONTHLY_BUDGET=30
# Alert threshold in USD for the daily cost-alert check (default: 5).
DAILY_COST_ALERT_USD=5

# ── Pattern detection / cross-repo ──────────────────────────────────────────────
# How many times a pattern must repeat across repos before patternDetector.ts
# flags it (default: 3).
PATTERN_DETECTION_THRESHOLD=3
# JSON object mapping repo -> array of repos that depend on it, so a push to one
# can notify/re-check the others. See crossRepoCoordinator.ts. Example:
# CROSS_REPO_DEPS={"core-lib":["app-a","app-b"]}
CROSS_REPO_DEPS=

# ── Brain / strategic auto-execution ────────────────────────────────────────────
# Whether sentinelBrain's daily strategy run can auto-execute its own
# recommendations. Set to 'false' to require manual approval instead (default: true).
BRAIN_AUTO_EXECUTE=true
